<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- A test body that returns null must compile without CS8603 (bam.test#8); as an error here, dropping the object? annotation from the test delegates breaks this build. -->
        <WarningsAsErrors>$(WarningsAsErrors);CS8603</WarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\bam.base\bam.base\bam.base.csproj" />
      <ProjectReference Include="..\..\bam.generators\bam.generators\bam.generators.csproj" />
      <ProjectReference Include="..\bam.test\bam.test.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Integration\" />
    </ItemGroup>

</Project>
